# Dependencies
node_modules/

# Local environment
.env
.env.*
*.local

# Firebase / Google credentials — these belong in the GitHub secret store,
# never in the repository. See DEPLOYMENT.md.
serviceAccount*.json
firebase-sa.json
*-firebase-adminsdk-*.json
gcloud-credentials*.json

