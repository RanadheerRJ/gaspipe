rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userPath());
    }

    function getUserData() {
      return get(userPath()).data;
    }

    function isSuperAdmin() {
      return hasUserProfile() && getUserData().role == 'superadmin';
    }

    function isStationAdmin() {
      return hasUserProfile() && getUserData().role == 'stationadmin';
    }

    function isStaff() {
      return hasUserProfile() && getUserData().role == 'staff';
    }

    function hasAccessToStation(stationId) {
      return isSuperAdmin()
        || (hasUserProfile() && stationId in getUserData().stationIds);
    }

    function bootstrapPath() {
      return /databases/$(database)/documents/app/bootstrap;
    }

    function bootstrapExists() {
      return exists(bootstrapPath());
    }

    function hasOnlyUserFields() {
      return request.resource.data.keys().hasOnly([
        'email', 'role', 'stationIds', 'createdBy', 'createdAt'
      ]);
    }

    function isOwnProfile(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.stationIds is list
        && request.resource.data.stationIds.size() == 0
        && hasOnlyUserFields();
    }

    function isOwnBootstrapProfile(uid) {
      return isOwnProfile(uid)
        && !bootstrapExists()
        && request.resource.data.role == 'superadmin'
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isOwnStaffProfile(uid) {
      return isOwnProfile(uid)
        && bootstrapExists()
        && request.resource.data.role == 'staff'
        && request.resource.data.createdBy == 'system';
    }

    function isStationAdminCreatingStaff() {
      return isStationAdmin()
        && request.resource.data.role == 'staff'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.stationIds is list
        && hasOnlyUserFields();
    }

    // ── App metadata ────────────────────────────────────────────────
    match /app/{docId} {
      // Signed-in users may read the bootstrap marker so the client can know
      // whether the first Super Admin has already been created.
      allow get: if isSignedIn() && docId == 'bootstrap';
      allow list: if isSuperAdmin();

      // First signup creates this marker in the same batch as the Super Admin
      // profile. Super Admins may recreate it if an older project is missing it.
      allow create: if isSignedIn()
        && docId == 'bootstrap'
        && !bootstrapExists()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow update, delete: if isSuperAdmin();
    }

    // ── Users collection ────────────────────────────────────────────
    match /users/{uid} {
      // Users can read their own profile. Super Admin can read all profiles.
      // Station Admin can read staff profiles they created.
      allow read: if isSignedIn()
        && (
          request.auth.uid == uid
          || isSuperAdmin()
          || (isStationAdmin() && resource.data.createdBy == request.auth.uid)
        );

      // First signup may create the bootstrap Super Admin profile; later public
      // signups may create only their own empty Staff profile. Admin-created
      // users are still written by the currently signed-in admin.
      allow create: if isSignedIn()
        && (
          isSuperAdmin()
          || isOwnBootstrapProfile(uid)
          || isOwnStaffProfile(uid)
          || isStationAdminCreatingStaff()
        );

      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // ── Stations collection ─────────────────────────────────────────
    match /stations/{stationId} {
      // Any authenticated user with access can read a station
      allow read: if isSignedIn() && hasAccessToStation(stationId);
      // Only Super Admin can create/update/delete stations
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();

      // ── Pumps subcollection ─────────────────────────────────────
      match /pumps/{pumpId} {
        allow read: if isSignedIn() && hasAccessToStation(stationId);
        allow create: if isSignedIn() && (isSuperAdmin() || isStationAdmin()) && hasAccessToStation(stationId);
        allow update: if isSignedIn() && (isSuperAdmin() || isStationAdmin()) && hasAccessToStation(stationId);
        allow delete: if isSignedIn() && (isSuperAdmin() || isStationAdmin()) && hasAccessToStation(stationId);
      }

      // ── Rates subcollection ─────────────────────────────────────
      match /rates/{rateId} {
        allow read: if isSignedIn() && hasAccessToStation(stationId);
        allow create: if isSignedIn() && (isSuperAdmin() || isStationAdmin()) && hasAccessToStation(stationId);
        allow update: if isSignedIn() && (isSuperAdmin() || isStationAdmin()) && hasAccessToStation(stationId);
        allow delete: if isSignedIn() && (isSuperAdmin() || isStationAdmin()) && hasAccessToStation(stationId);
      }

      // ── Shifts subcollection ────────────────────────────────────
      match /shifts/{shiftId} {
        // Any user with station access can read shifts and create shift records.
        allow read: if isSignedIn() && hasAccessToStation(stationId);
        allow create: if isSignedIn() && hasAccessToStation(stationId);
        // Only Super Admin and Station Admin can update/delete shifts.
        allow update: if isSignedIn() && (isSuperAdmin() || isStationAdmin()) && hasAccessToStation(stationId);
        allow delete: if isSignedIn() && (isSuperAdmin() || isStationAdmin()) && hasAccessToStation(stationId);
      }
    }
  }
}
