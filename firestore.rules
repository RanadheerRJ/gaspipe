rules_version = '2';

/*
 * PumpLog security rules — server-side source of truth for RBAC.
 * The client mirrors this logic in js/auth.js `can()` purely for rendering.
 *
 * Roles (hierarchy, highest → lowest)
 *   superadmin    — full control everywhere from world
 *   stationadmin  — rates/pumps/shifts + staff they created, on assigned
 *                   stations; can also create managers for their stations
 *   manager       — Station Manager: same operational powers as stationadmin
 *                   (pumps, rates, shifts, staff they created, shift approvals)
 *                   EXCEPT cannot create/edit/delete stations, cannot create
 *                   other managers or station admins, and only manages staff
 *                   they personally created
 *   staff        — read assigned stations, log shifts on their assigned pumps,
 *                  and read ONLY their own shift records
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn()
        && exists(userPath())
        && (!get(userPath()).data.keys().hasAny(['status'])
            || get(userPath()).data.status != 'disabled');
    }

    function me() {
      return get(userPath()).data;
    }

    function myRole() {
      return hasProfile() ? me().role : '';
    }

    function isSuperAdmin()   { return myRole() == 'superadmin'; }
    function isStationAdmin() { return myRole() == 'stationadmin'; }
    function isManager()      { return myRole() == 'manager'; }

    function myStations() {
      return hasProfile() && me().stationIds is list ? me().stationIds : [];
    }

    // Super Admins reach every station; everyone else needs an assignment.
    function canAccessStation(stationId) {
      return isSuperAdmin() || (hasProfile() && stationId in myStations());
    }

    function canManageStation(stationId) {
      return isSuperAdmin()
        || (isStationAdmin() && stationId in myStations())
        || (isManager() && stationId in myStations());
    }

    // Staff pump restrictions are enforced here as well as in js/auth.js.
    // Missing/empty pumpIds intentionally means every pump at an assigned
    // station, preserving access for older profiles.
    function myPumps() {
      return hasProfile()
        && me().keys().hasAny(['pumpIds'])
        && me().pumpIds is list
        ? me().pumpIds : [];
    }

    // Daily roster: stations/{id}/assignments/{date}_{pumpId}
    function assignmentPath(stationId, date, pumpId) {
      return /databases/$(database)/documents/stations/$(stationId)/assignments/$(date + '_' + pumpId);
    }

    function rosteredOn(stationId, date, pumpId) {
      return exists(assignmentPath(stationId, date, pumpId))
        && get(assignmentPath(stationId, date, pumpId)).data.staffUids is list
        && request.auth.uid in get(assignmentPath(stationId, date, pumpId)).data.staffUids;
    }

    // True when the board rosters the caller onto this pump for the shift
    // date carried by the document being written.
    //
    // The date is taken from the request rather than from request.time
    // because board dates are the station's LOCAL calendar day while
    // request.time is UTC — the two disagree for part of every day in any
    // non-UTC zone (a 01:00 IST shift is still "yesterday" in UTC). Both the
    // session lock and the shift record carry a validated `date` string, and
    // being rostered on a pump is a genuine assignment whichever day it is,
    // so this stays accurate without a timezone guess. The atomic pump-lock
    // transaction remains the real authority over who holds a pump.
    function rosteredForRequest(stationId, pumpId) {
      return request.resource.data.keys().hasAny(['date'])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && rosteredOn(stationId, request.resource.data.date, pumpId);
    }

    // A staff member may use a pump when the daily board rosters them onto it,
    // OR their standing pumpIds list includes it, OR they have no restriction
    // at all (empty standing list). The last case keeps brand-new accounts
    // working before anyone has touched the roster.
    function canUsePump(stationId, pumpId) {
      return canManageStation(stationId)
        || (myRole() == 'staff'
            && canAccessStation(stationId)
            && (myPumps().size() == 0
                || pumpId in myPumps()
                || rosteredForRequest(stationId, pumpId)));
    }

    function assignmentFieldsOk() {
      return request.resource.data.keys().hasAll(['date', 'pumpId', 'staffUids'])
        && request.resource.data.keys().hasOnly([
             'date', 'pumpId', 'pumpName', 'product', 'staffUids', 'staffNames',
             'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
           ])
        && request.resource.data.date is string
        && request.resource.data.pumpId is string
        && request.resource.data.staffUids is list
        && request.resource.data.staffUids.size() <= 20
        && (!request.resource.data.keys().hasAny(['note'])
            || (request.resource.data.note is string && request.resource.data.note.size() <= 300));
    }

    function sessionPath(stationId, pumpId) {
      return /databases/$(database)/documents/stations/$(stationId)/pumpSessions/$(pumpId);
    }

    function sessionFieldsOk() {
      return request.resource.data.keys().hasAll([
          'status', 'activeUid', 'activeName', 'pumpName', 'product',
          'clockInAt', 'opening', 'date', 'shiftLabel', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'status', 'activeUid', 'activeName', 'pumpName', 'product',
          'clockInAt', 'opening', 'date', 'shiftLabel', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.status in ['idle', 'active'];
    }

    function writesActiveSession(stationId, pumpId) {
      return sessionFieldsOk()
        && request.resource.data.status == 'active'
        // Staff can only start their own assigned pump. Managers may delegate
        // a start to a station employee; the transaction still enforces one lock.
        && (request.resource.data.activeUid == request.auth.uid || canManageStation(stationId))
        && (canUsePump(stationId, pumpId) || canManageStation(stationId));
    }

    function writesIdleSession() {
      return sessionFieldsOk() && request.resource.data.status == 'idle';
    }

    // Clock-out authority comes from the active lock, not from a roster entry
    // that may be changed after clock-in. The shift create still has to happen
    // atomically with that exact lock becoming idle (see /shifts below).
    function ownsActiveSession(stationId, pumpId) {
      return exists(sessionPath(stationId, pumpId))
        && get(sessionPath(stationId, pumpId)).data.status == 'active'
        && get(sessionPath(stationId, pumpId)).data.activeUid == request.auth.uid;
    }

    function bootstrapPath() {
      return /databases/$(database)/documents/app/bootstrap;
    }

    function bootstrapExists() {
      return exists(bootstrapPath());
    }

    // ── Validation helpers ──────────────────────────────────────────
    function isValidRole(role) {
      return role in ['superadmin', 'stationadmin', 'manager', 'staff'];
    }

    function userFieldsOk() {
      return request.resource.data.keys().hasAll(['role', 'stationIds'])
        && (request.resource.data.keys().hasAny(['email'])
            || request.resource.data.keys().hasAny(['username']))
        && request.resource.data.keys().hasOnly([
             'email', 'firstName', 'lastName', 'fullName', 'username', 'phoneNumber',
             'employeeId', 'avatarUrl', 'role', 'stationIds', 'pumpIds',
             'status', 'createdBy', 'createdByAdmin', 'createdAt', 'updatedAt', 'updatedBy',
             'lastLogin', 'lastLogout', 'pinUpdatedAt', 'pin_reset_required', 'password_reset_required',
             'pwaLoginAllowed', 'isAdmin', 'loginMethod'
           ])
        && request.resource.data.stationIds is list
        && request.resource.data.stationIds.size() <= 50
        && (!request.resource.data.keys().hasAny(['pumpIds'])
            || (request.resource.data.pumpIds is list
                && request.resource.data.pumpIds.size() <= 200))
        && (!request.resource.data.keys().hasAny(['fullName']) || request.resource.data.fullName is string)
        && (!request.resource.data.keys().hasAny(['username']) || request.resource.data.username is string)
        && (!request.resource.data.keys().hasAny(['phoneNumber']) || request.resource.data.phoneNumber is string)
        && (!request.resource.data.keys().hasAny(['status'])
            || request.resource.data.status in ['invited', 'active', 'disabled'])
        && (!request.resource.data.keys().hasAny(['pin_reset_required'])
            || request.resource.data.pin_reset_required is bool)
        && (!request.resource.data.keys().hasAny(['password_reset_required'])
            || request.resource.data.password_reset_required is bool)
        && (!request.resource.data.keys().hasAny(['pwaLoginAllowed'])
            || request.resource.data.pwaLoginAllowed is bool)
        && (!request.resource.data.keys().hasAny(['isAdmin'])
            || request.resource.data.isAdmin is bool)
        && isValidRole(request.resource.data.role);
    }

    // Fields a self-signup may set on its own profile.
    function isOwnNewProfile(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.stationIds.size() == 0
        && (!request.resource.data.keys().hasAny(['pumpIds'])
            || request.resource.data.pumpIds.size() == 0)
        && userFieldsOk();
    }

    function isBootstrapSuperAdmin(uid) {
      return isOwnNewProfile(uid)
        && !bootstrapExists()
        && request.resource.data.role == 'superadmin'
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isSelfSignupStaff(uid) {
      return isOwnNewProfile(uid)
        && bootstrapExists()
        && request.resource.data.role == 'staff'
        && request.resource.data.createdBy == 'system';
    }

    // A Station Admin may only mint staff, only for stations they hold.
    function stationAdminCreatingStaff() {
      return isStationAdmin()
        && userFieldsOk()
        && request.resource.data.role == 'staff'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.stationIds.hasOnly(myStations());
    }

    // A Station Admin may mint a manager for stations they hold.
    function stationAdminCreatingManager() {
      return isStationAdmin()
        && userFieldsOk()
        && request.resource.data.role == 'manager'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.stationIds.hasOnly(myStations());
    }

    // A Manager may only mint staff (not other managers/admins), only for
    // stations they hold.
    function managerCreatingStaff() {
      return isManager()
        && userFieldsOk()
        && request.resource.data.role == 'staff'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.stationIds.hasOnly(myStations());
    }

    // Station Admins may edit only the staff accounts they created, and may
    // never escalate a role or grant a station they do not hold themselves.
    function stationAdminUpdatingOwnStaff() {
      return isStationAdmin()
        && resource.data.role == 'staff'
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.role == 'staff'
        && ((!resource.data.keys().hasAny(['email']) && !request.resource.data.keys().hasAny(['email']))
            || request.resource.data.email == resource.data.email)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.stationIds.hasOnly(myStations())
        && userFieldsOk();
    }

    // A Manager may edit only the staff accounts they created.
    function managerUpdatingOwnStaff() {
      return isManager()
        && resource.data.role == 'staff'
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.role == 'staff'
        && ((!resource.data.keys().hasAny(['email']) && !request.resource.data.keys().hasAny(['email']))
            || request.resource.data.email == resource.data.email)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.stationIds.hasOnly(myStations())
        && userFieldsOk();
    }

    // Team management is station-scoped, not creator-scoped: a Station Admin
    // must be able to roster and edit staff that one of their Managers
    // created (and vice versa), otherwise the daily board can only ever show
    // half the team. Role escalation is still blocked — the target stays
    // 'staff' and may only hold stations the caller holds.
    function targetIsMyStationStaff() {
      return resource.data.role == 'staff'
        && resource.data.stationIds is list
        && resource.data.stationIds.hasAny(myStations());
    }

    function overseerUpdatingStationStaff() {
      return (isStationAdmin() || isManager())
        && targetIsMyStationStaff()
        && request.resource.data.role == 'staff'
        && ((!resource.data.keys().hasAny(['email']) && !request.resource.data.keys().hasAny(['email']))
            || request.resource.data.email == resource.data.email)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.stationIds.hasOnly(myStations())
        && userFieldsOk();
    }

    function stationAdminDeletingOwnStaff() {
      return isStationAdmin()
        && resource.data.role == 'staff'
        && resource.data.createdBy == request.auth.uid;
    }

    function managerDeletingOwnStaff() {
      return isManager()
        && resource.data.role == 'staff'
        && resource.data.createdBy == request.auth.uid;
    }

    function selfUpdatingRuntimeFields(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid == uid
        && userFieldsOk()
        && changed.hasOnly([
          'lastLogin', 'lastLogout', 'pinUpdatedAt',
          'pin_reset_required', 'password_reset_required',
          'updatedAt', 'updatedBy'
        ])
        && (!changed.hasAny(['pin_reset_required']) || request.resource.data.pin_reset_required == false)
        && (!changed.hasAny(['password_reset_required']) || request.resource.data.password_reset_required == false)
        && (!changed.hasAny(['updatedBy']) || request.resource.data.updatedBy == request.auth.uid);
    }

    // ── App metadata ────────────────────────────────────────────────
    match /app/{docId} {
      allow get: if isSignedIn() && docId == 'bootstrap';
      allow list: if isSuperAdmin();

      // Claimed once, by the first signup, in the same batch as its profile.
      allow create: if isSignedIn()
        && docId == 'bootstrap'
        && !bootstrapExists()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow update, delete: if isSuperAdmin();
    }

    // ── Users ───────────────────────────────────────────────────────
    match /users/{uid} {
      allow get: if isSignedIn()
        && (
             request.auth.uid == uid
          || isSuperAdmin()
          || (isStationAdmin() && resource.data.createdBy == request.auth.uid)
          || (isManager() && resource.data.createdBy == request.auth.uid)
          // Anyone sharing a station with the caller, so the roster board can
          // resolve names for staff someone else created.
          || ((isStationAdmin() || isManager())
              && resource.data.stationIds is list
              && resource.data.stationIds.hasAny(myStations()))
        );

      // Super Admin lists everyone. Managers and Station Admins must scope
      // their query — either to the accounts they created, or to one of their
      // own stations (array-contains). An unscoped list returns a doc that
      // fails this condition, so Firestore rejects the whole query.
      allow list: if isSuperAdmin()
        || (isStationAdmin() && resource.data.createdBy == request.auth.uid)
        || (isManager() && resource.data.createdBy == request.auth.uid)
        || ((isStationAdmin() || isManager())
            && resource.data.stationIds is list
            && resource.data.stationIds.hasAny(myStations()));

      allow create: if isSignedIn() && (
           (isSuperAdmin() && userFieldsOk())
        || isBootstrapSuperAdmin(uid)
        || isSelfSignupStaff(uid)
        || stationAdminCreatingStaff()
        || stationAdminCreatingManager()
        || managerCreatingStaff()
      );

      // Super Admin may edit anyone except their own role (no self-lockout).
      allow update: if isSignedIn() && (
           (isSuperAdmin() && request.auth.uid != uid && userFieldsOk())
        || stationAdminUpdatingOwnStaff()
        || managerUpdatingOwnStaff()
        || overseerUpdatingStationStaff()
        || selfUpdatingRuntimeFields(uid)
      );

      // Deleting the profile revokes app access. The last Super Admin and the
      // caller's own account are protected.
      allow delete: if isSignedIn()
        && request.auth.uid != uid
        && (
             (isSuperAdmin() && resource.data.role != 'superadmin')
          || stationAdminDeletingOwnStaff()
          || managerDeletingOwnStaff()
        );
    }

    // ── Legacy trusted identity records ────────────────────────────
    // Free mode does not use these collections. Keep them client-inaccessible
    // so any old PIN/joining-code records cannot be read from the browser.
    match /staffSecrets/{uid} {
      allow read, write: if false;
    }

    match /usernames/{username} {
      allow read, write: if false;
    }

    match /joiningCodes/{code} {
      allow read, write: if false;
    }

    match /adminInvites/{code} {
      allow read, write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Server-owned sign-in throttling counters; clients never touch them.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ── Stations ────────────────────────────────────────────────────
    match /stations/{stationId} {
      allow get: if isSignedIn() && canAccessStation(stationId);

      // Evaluated per returned document: a Super Admin may list everything,
      // while Station Admins and Staff must scope the query to their assigned
      // ids (the client uses a `documentId() in [...]` query). A broader query
      // would return a document that fails this check and be rejected.
      allow list: if isSignedIn() && canAccessStation(stationId);

      allow create, update, delete: if isSuperAdmin();

      // ── Station security settings ─────────────────────────────────
      // Feature flags and policy numbers only — never secrets. Free mode uses
      // email + Cloud PIN through Firebase Auth; only station managers may
      // change App Lock / Cloud PIN policy settings.
      match /settings/{docId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && canManageStation(stationId);
      }

      // ── Pumps ─────────────────────────────────────────────────────
      match /pumps/{pumpId} {
        allow read: if isSignedIn() && canAccessStation(stationId);
        allow create, update, delete: if isSignedIn() && canManageStation(stationId);
      }

      // ── Daily pump assignments (Kanban roster) ────────────────────
      // Every station member reads the board so staff can see where they are
      // rostered; only managers and admins change it.
      match /assignments/{assignmentId} {
        allow read: if isSignedIn() && canAccessStation(stationId);

        allow create, update: if isSignedIn()
          && canManageStation(stationId)
          && assignmentFieldsOk()
          && assignmentId == request.resource.data.date + '_' + request.resource.data.pumpId;

        allow delete: if isSignedIn() && canManageStation(stationId);
      }

      // ── Rates ─────────────────────────────────────────────────────
      match /rates/{rateId} {
        allow read: if isSignedIn() && canAccessStation(stationId);

        allow create: if isSignedIn()
          && canManageStation(stationId)
          && request.resource.data.rate is number
          && request.resource.data.rate >= 0
          && request.resource.data.product is string
          && request.resource.data.effectiveDate is string;

        allow update: if isSignedIn()
          && canManageStation(stationId)
          && request.resource.data.rate is number
          && request.resource.data.rate >= 0;

        allow delete: if isSignedIn() && canManageStation(stationId);
      }

      // ── Live pump session locks ──────────────────────────────────
      match /pumpSessions/{pumpId} {
        // Every signed-in station member needs this read for live lock UI.
        allow read: if isSignedIn() && canAccessStation(stationId);

        // A transaction may create a missing lock or claim an existing idle
        // lock. It may never overwrite an active lock with another active one.
        allow create: if isSignedIn()
          && canAccessStation(stationId)
          && writesActiveSession(stationId, pumpId)
          && !exists(sessionPath(stationId, pumpId));

        allow update: if isSignedIn()
          && canAccessStation(stationId)
          && (
               // Missing document (read by transaction, then set) — treat as create.
               (resource == null
                && request.resource.data.status == 'active'
                && writesActiveSession(stationId, pumpId))
            || (resource != null && resource.data.status == 'idle'
                && request.resource.data.status == 'active'
                && writesActiveSession(stationId, pumpId))
            || (resource != null && resource.data.status == 'active'
                && writesIdleSession()
                && (resource.data.activeUid == request.auth.uid || canManageStation(stationId)))
          );

        // Station reset is the only bulk delete path and is manager-only.
        allow delete: if isSignedIn() && canManageStation(stationId);
      }

      // ── Immutable audit trail ─────────────────────────────────────
      match /auditLogs/{auditId} {
        allow read: if isSignedIn() && canManageStation(stationId);
        allow create: if isSignedIn() && canAccessStation(stationId)
          && request.resource.data.keys().hasAll(['timestamp', 'userId', 'role', 'stationId', 'action', 'affectedObject'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.stationId == stationId;
        allow update, delete: if false;
      }

      // ── Daily reports ──────────────────────────────────────────────
      match /dailyReports/{reportId} {
        allow read: if isSignedIn() && canManageStation(stationId);
        allow create: if isSignedIn() && canManageStation(stationId)
          && request.resource.data.date == reportId
          && request.resource.data.status == 'Draft';
        allow update: if isSignedIn() && canManageStation(stationId)
          && resource.data.date == reportId
          && (
            (resource.data.status == 'Draft' && request.resource.data.status in ['Draft', 'Submitted'])
            || (resource.data.status == 'Submitted' && request.resource.data.status == 'Approved')
            || (isStationAdmin() && request.resource.data.status in ['Draft', 'Submitted', 'Approved', 'Locked'])
          );
        allow delete: if false;
      }

      // ── Shifts ────────────────────────────────────────────────────
      match /shifts/{shiftId} {
        // Managers (Super/Station Admin) read every record at the station.
        // Staff read ONLY their own records, so their list queries use
        // where('staffUid', '==', <uid>). createdBy may be a Manager who
        // performed clock-out on their behalf.
        allow read: if isSignedIn()
          && canAccessStation(stationId)
          && (canManageStation(stationId)
              // `createdBy` is the person who performed clock-out. When a
              // manager ends a shift for Staff, ownership is in staffUid.
              || (resource.data.keys().hasAny(['staffUid'])
                  && resource.data.staffUid == request.auth.uid)
              || resource.data.createdBy == request.auth.uid);

        // Any user with station access may log a reading, but only as
        // themselves and only with sane numbers. A manager may close a shift
        // on behalf of a staff member (the session's activeUid).
        allow create: if isSignedIn()
          && canAccessStation(stationId)
          // Starting a shift is assignment-gated, but ending one is lock-gated.
          // Keep a legitimate owner able to finish after midnight or after a
          // manager edits/removes the day's board entry or standing pump list.
          && (canUsePump(stationId, request.resource.data.pumpId)
              || ownsActiveSession(stationId, request.resource.data.pumpId))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasAll([
               'staffId', 'staffUid', 'staffName', 'clockInAt', 'clockOutAt', 'hoursWorked'
             ])
          && request.resource.data.staffName is string
          && request.resource.data.clockInAt is timestamp
          && request.resource.data.clockOutAt is timestamp
          && request.resource.data.hoursWorked is number
          && request.resource.data.hoursWorked >= 0
          && request.resource.data.volume is number
          && request.resource.data.volume >= 0
          && request.resource.data.rate is number
          && request.resource.data.rate >= 0
          && request.resource.data.date is string
          // New Part C fields — optional but type-checked if present
          && (!request.resource.data.keys().hasAny(['notes']) || request.resource.data.notes is string)
          && (!request.resource.data.keys().hasAny(['expenses']) || request.resource.data.expenses is list)
          && (!request.resource.data.keys().hasAny(['expensesTotal']) || (request.resource.data.expensesTotal is number && request.resource.data.expensesTotal >= 0))
          && (!request.resource.data.keys().hasAny(['cashDue']) || (request.resource.data.cashDue is number && request.resource.data.cashDue >= 0))
          && (!request.resource.data.keys().hasAny(['testingFuel']) || (request.resource.data.testingFuel is number && request.resource.data.testingFuel >= 0))
          && (!request.resource.data.keys().hasAny(['creditsTotal']) || (request.resource.data.creditsTotal is number && request.resource.data.creditsTotal >= 0))
          && (!request.resource.data.keys().hasAny(['digitalPaymentsTotal']) || (request.resource.data.digitalPaymentsTotal is number && request.resource.data.digitalPaymentsTotal >= 0))
          && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['pending', 'approved', 'rejected'])
          // A new shift is valid only as the same atomic operation that
          // closes this user's active session. This prevents direct writes
          // from bypassing the pump lock.
          && exists(sessionPath(stationId, request.resource.data.pumpId))
          && get(sessionPath(stationId, request.resource.data.pumpId)).data.status == 'active'
          && (
               // Self clock-out: the writer is the session owner
               (get(sessionPath(stationId, request.resource.data.pumpId)).data.activeUid == request.auth.uid
                && request.resource.data.staffId == request.auth.uid
                && request.resource.data.staffUid == request.auth.uid)
               // Manager closing on behalf of staff: writer manages the station
               // and shift staff fields match the session owner
            || (canManageStation(stationId)
                && request.resource.data.staffId == get(sessionPath(stationId, request.resource.data.pumpId)).data.activeUid
                && request.resource.data.staffUid == get(sessionPath(stationId, request.resource.data.pumpId)).data.activeUid)
          )
          && getAfter(sessionPath(stationId, request.resource.data.pumpId)).data.status == 'idle'
          && getAfter(sessionPath(stationId, request.resource.data.pumpId)).data.activeUid == null;

        // Corrections are an admin action.
        allow update, delete: if isSignedIn() && canManageStation(stationId);
      }
    }
  }
}
